{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neighborhood-listing-platform.example/schema/property.schema.json",
  "title": "Property",
  "description": "A real estate listing shown on the neighborhood listing platform.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id", "title", "address", "price", "bedrooms", "bathrooms",
    "square_feet", "property_type", "image_url", "image_alt"
  ],
  "properties": {
    "property_id": {
      "type": "string",
      "pattern": "^prop-[0-9]{3,}$",
      "description": "Primary key, e.g. prop-101."
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 100 },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "city", "state", "zip_code"],
      "properties": {
        "street": { "type": "string", "minLength": 3 },
        "city": { "type": "string", "minLength": 2 },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "zip_code": { "type": "string", "pattern": "^[0-9]{5}$" }
      }
    },
    "price": { "type": "integer", "exclusiveMinimum": 0, "maximum": 100000000 },
    "bedrooms": { "type": "integer", "minimum": 0, "maximum": 20 },
    "bathrooms": { "type": "number", "minimum": 0, "maximum": 20, "multipleOf": 0.5 },
    "square_feet": { "type": "integer", "exclusiveMinimum": 0, "maximum": 100000 },
    "property_type": {
      "type": "string",
      "enum": ["house", "condo", "townhouse", "apartment", "land"]
    },
    "image_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "image_alt": { "type": "string", "minLength": 10, "maxLength": 200 },
    "is_featured": { "type": "boolean", "default": false },
    "local_sponsors": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^spon-[0-9]{2,}$" },
      "description": "Denormalized convenience list of sponsor_ids; the join entity is the source of truth."
    }
  }
}
