{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neighborhood-listing-platform.example/schema/property_sponsor.schema.json",
  "title": "PropertySponsor",
  "description": "Join entity for the many-to-many relationship between Property and Sponsor. Composite key: (property_id, sponsor_id).",
  "type": "object",
  "additionalProperties": false,
  "required": ["property_id", "sponsor_id"],
  "properties": {
    "property_id": { "type": "string", "pattern": "^prop-[0-9]{3,}$" },
    "sponsor_id": { "type": "string", "pattern": "^spon-[0-9]{2,}$" },
    "placement": { "type": "string", "enum": ["banner", "sidebar", "inline"], "default": "banner" }
  }
}
