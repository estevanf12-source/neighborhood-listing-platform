{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neighborhood-listing-platform.example/schema/sponsor.schema.json",
  "title": "Sponsor",
  "description": "A local business that sponsors neighborhood listings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sponsor_id", "business_name", "headline", "cta_text", "target_url", "logo_url", "logo_alt"],
  "properties": {
    "sponsor_id": { "type": "string", "pattern": "^spon-[0-9]{2,}$" },
    "business_name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "headline": { "type": "string", "minLength": 5, "maxLength": 140 },
    "cta_text": { "type": "string", "minLength": 2, "maxLength": 30 },
    "target_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "logo_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "logo_alt": { "type": "string", "minLength": 5, "maxLength": 200 }
  }
}
